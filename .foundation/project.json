{
  "schema_version": 2,
  "project_name": "rpn-calc",
  "checks": {
    "lint": {
      "argv": ["python3", "tools/lint.py"],
      "timeout_seconds": 120
    },
    "typecheck": {
      "argv": ["python3", "tools/typecheck.py"],
      "timeout_seconds": 120
    },
    "unit": {
      "argv": ["python3", "-m", "unittest", "discover", "-s", "tests", "-p", "test_unit_*.py", "-t", "."],
      "timeout_seconds": 300
    },
    "integration": {
      "argv": ["python3", "-m", "unittest", "discover", "-s", "tests", "-p", "test_integration_*.py", "-t", "."],
      "timeout_seconds": 300
    },
    "e2e": {
      "argv": ["python3", "tools/e2e.py"],
      "timeout_seconds": 300
    },
    "build": {
      "argv": ["python3", "tools/build.py"],
      "timeout_seconds": 300
    },
    "security": {
      "argv": ["python3", "tools/security.py"],
      "timeout_seconds": 120
    },
    "architecture": {
      "argv": ["python3", "tools/architecture.py"],
      "timeout_seconds": 120
    }
  },
  "required_ci_checks": [
    "lint",
    "typecheck",
    "unit",
    "integration",
    "e2e",
    "build",
    "security",
    "architecture"
  ],
  "not_applicable": {
    "docs/DESIGN.md": "rpn-calc is a headless command-line tool with no visual or UX design surface",
    "docs/FRONTEND.md": "rpn-calc is a headless command-line tool; there is no runtime UI or device surface to verify"
  }
}
